PGHOST=127.0.0.1
PGPORT=5432
PGUSER=fitfuel
PGPASSWORD=change-me
PGDATABASE=fitfuel
PGSSL=false
DATABASE_URL=postgresql://fitfuel:change-me@127.0.0.1:5432/fitfuel
COOKIE_SECURE=false
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=replace-with-your-mimo-api-key
MIMO_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5
# MiMo 单张视觉截图最长等待时间，默认 300000（5 分钟）
MIMO_VISION_TIMEOUT_MS=300000
# 上传根目录（Docker 部署时被 docker-compose.yml 中的 PRIVATE_UPLOAD_DIR=/app/uploads 覆盖，无需修改）
PRIVATE_UPLOAD_DIR=.private/elevatine-imports
AI_CANDIDATE_SECRET=replace-with-at-least-32-random-characters
SOURCE_DATABASE=food_db
TARGET_DATABASE=fitfuel
FITFUEL_ADMIN_EMAIL=xnysym@outlook.com
COROS_API_BASE_URL=https://teamcnapi.coros.com
COROS_TEAM_API_BASE_URL=https://teamcnapi.coros.com
COROS_ACCOUNT=replace-with-your-coros-account
COROS_PASSWORD=replace-with-your-coros-password
