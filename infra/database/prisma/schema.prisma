  @@schema("fitfuel")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model water_log {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  amount_ml  Int
  logged_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  app_user   app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, logged_at(sort: Desc)], map: "ix_water_log_user_time")
  @@schema("fitfuel")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model food {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  category_id        Int?
  brand              String?              @db.VarChar(255)
  description        String?
  image_url          String?
  status             Int?                 @default(1)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  ai_food_lookup     ai_food_lookup[]
  food_catalog_audit food_catalog_audit[]
  meal_item          meal_item[]
  food_category      food_category?       @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  food_nutrition     food_nutrition[]
  food_serving       food_serving[]

  @@schema("food_info")
}

model food_category {
  id         Int    @id @default(autoincrement())
  parent_id  Int?   @default(0)
  name       String @db.VarChar(255)
  sort_order Int?   @default(0)
  food       food[]

  @@schema("food_info")
}

model food_nutrition {
  id            Int     @id @default(autoincrement())
  food_id       Int
  unit          String? @default("100g") @db.VarChar(64)
  calories      Float   @db.Real
  protein       Float?  @default(0) @db.Real
  fat           Float?  @default(0) @db.Real
  carbohydrate  Float?  @default(0) @db.Real
  dietary_fiber Float?  @default(0) @db.Real
  sugar         Float?  @default(0) @db.Real
  sodium        Float?  @default(0) @db.Real
  cholesterol   Float?  @default(0) @db.Real
  food          food    @relation(fields: [food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([food_id, unit])
  @@index([food_id], map: "ix_food_nutrition_food")
  @@schema("food_info")
}

model food_serving {
  id           Int     @id @default(autoincrement())
  food_id      Int
  serving_name String  @db.VarChar(255)
  gram_weight  Float   @db.Real
  unit_type    String? @default("g") @db.VarChar(32)
  is_default   Int?    @default(0)
  food         food    @relation(fields: [food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([food_id], map: "ix_food_serving_food")
  @@schema("food_info")
}
